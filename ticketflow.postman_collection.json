{
  "info": {
    "name": "TICKETFLOW",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "adminKey",
      "value": "본인의_ADMIN_API_KEY"
    },
    {
      "key": "id",
      "value": "3"
    }
  ],
  "item": [
    {
      "name": "0. 서버 확인",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "1. 공연 목록 조회",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/performances"
      }
    },
    {
      "name": "2. 공연 등록",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-admin-key",
            "value": "{{adminKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"TICKETFLOW 테스트 공연\",\n  \"venue\": \"테스트 공연장\",\n  \"starts_at\": \"2026-12-25T19:00:00+09:00\",\n  \"price\": 30000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/performances"
      }
    },
    {
      "name": "3. 공연 수정",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-admin-key",
            "value": "{{adminKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"수정된 테스트 공연\",\n  \"price\": 40000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/performances/{{id}}"
      }
    },
    {
      "name": "4. 공연 삭제",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "x-admin-key",
            "value": "{{adminKey}}"
          }
        ],
        "url": "{{baseUrl}}/performances/{{id}}"
      }
    }
  ]
}
